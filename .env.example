# KURDIA ADVENTURE — Server & Cloudflare Worker Environment Variables
# Never expose these keys in frontend JavaScript. Keep all credentials server-side.

# 1. Gemini AI (Used by /api/ai and /api/admin/trends/analyze)
GEMINI_API_KEY=

# 2. Admin Authentication Key (Used for X-Admin-Key header verification)
ADMIN_SECRET_KEY=

# 3. Official Meta Graph API v19.0 (Optional — For Verified Instagram & Facebook Insights in AI Travel Trends Intelligence)
# Required permissions: instagram_basic, instagram_manage_insights, pages_read_engagement, pages_show_list
META_GRAPH_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# 4. Official TikTok Research / Commercial API (Optional — Never claim restricted access without approval)
TIKTOK_ACCESS_TOKEN=

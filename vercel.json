{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "admin.kurdiaadventure.com"
        }
      ],
      "dest": "/admin.html"
    },
    {
      "src": "^/(admin|control|kurdia-control-center-admin)/?$",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}

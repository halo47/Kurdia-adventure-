{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "admin.kurdiaadventure.com"
        }
      ],
      "dest": "/admin.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    },
    {
      "src": "^/(admin|control|kurdia-control-center-admin)/?$",
      "dest": "/admin.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    },
    {
      "src": "^/(index\\.html|admin\\.html|sw\\.js)$",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
